# Copy this file to  server/.env  and change the values.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/stem_outreach
JWT_SECRET=change_this_to_any_long_random_text_12345

# Development OTP: the OTP is ALWAYS printed in the server terminal.
# true = also show it on the website (handy for demos). Set to false for real use.
DEV_SHOW_OTP=true

# Optional: real email OTP (leave empty to use the terminal OTP)
# Gmail needs an "App Password" (Google Account > Security > App passwords)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# Admin account created by:  npm run seed
ADMIN_EMAIL=admin@stem.com
ADMIN_PASSWORD=Admin@123
